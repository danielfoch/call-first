{
  "manifest_version": 3,
  "name": "Call First",
  "version": "1.0.0",
  "description": "Blocks distracting sites until you make one outbound call in GoHighLevel (verified read-only via the GHL API).",
  "permissions": ["storage", "alarms", "declarativeNetRequest", "tabs"],
  "host_permissions": [
    "https://services.leadconnectorhq.com/*",
    "*://*.x.com/*", "*://x.com/*",
    "*://*.twitter.com/*", "*://twitter.com/*",
    "*://*.reddit.com/*", "*://reddit.com/*",
    "*://*.linkedin.com/*", "*://linkedin.com/*",
    "*://*.facebook.com/*", "*://facebook.com/*",
    "*://*.instagram.com/*", "*://instagram.com/*",
    "*://*.tiktok.com/*", "*://tiktok.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Call First", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["gate.html"], "matches": ["<all_urls>"] }]
}
